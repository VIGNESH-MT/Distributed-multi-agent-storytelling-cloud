# Copy to config.env (git-ignored) and edit. Sourced by every scripts/gcp/*.sh.

PROJECT_ID=your-gcp-project-id
# London region; any region with at least three zones works.
REGION=europe-west2

# --- Network (custom VPC; nodes and database have private IPs only)
NETWORK=storytelling-vpc
SUBNET=storytelling-subnet
SUBNET_RANGE=10.10.0.0/20
PODS_RANGE=10.20.0.0/16
SERVICES_RANGE=10.30.0.0/20

# --- GKE (regional cluster: one node per zone, three zones)
CLUSTER_NAME=storytelling-gke
NODE_MACHINE_TYPE=e2-standard-2
# Cluster-wide node autoscaling bounds. Free-trial accounts are limited to
# 8 vCPUs in total, i.e. at most 4 x e2-standard-2.
MIN_NODES=3
MAX_NODES=4

# --- Cloud SQL for PostgreSQL 16
DB_INSTANCE=storytelling-db
DB_NAME=storytelling
DB_USER=storyapp
# ZONAL (cheaper) or REGIONAL (high availability with automatic failover).
# REGIONAL needs a dedicated-core tier, e.g. DB_TIER=db-custom-1-3840.
DB_AVAILABILITY=ZONAL
DB_TIER=db-g1-small

# --- Images
AR_REPO=storytelling
# cloudbuild (build in Google Cloud Build) or docker (build in Cloud Shell)
BUILD_WITH=cloudbuild

# --- Load balancer
STATIC_IP_NAME=storytelling-ip

# --- Agents
# gemini: real LLM calls (needs the gemini-api-key secret, see the guide)
# mock:   deterministic agents, no LLM cost; use for scaling experiments
AGENT_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
# Synthetic CPU time per mock agent call, in ms (0 = off). Only for mock.
MOCK_AGENT_CPU_MS=0
