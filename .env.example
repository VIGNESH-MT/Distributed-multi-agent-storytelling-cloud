POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=storytelling
POSTGRES_USER=storyapp
POSTGRES_PASSWORD=replace_with_your_local_secret
# Set to "require" when connecting to Cloud SQL.
POSTGRES_SSLMODE=

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# gemini | mock
STORY_AGENT_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-3.6-flash

# local: agents run inside the API process; remote: agents are called over HTTP.
AGENT_EXECUTION_MODE=local
PLOT_AGENT_URL=http://storytelling-plot-agent:8000
CHARACTER_AGENT_URL=http://storytelling-character-agent:8000
CRITIC_AGENT_URL=http://storytelling-critic-agent:8000
AGENT_REQUEST_TIMEOUT_SECONDS=240

# Synthetic CPU cost per mock agent call (scaling experiments only).
MOCK_AGENT_CPU_MS=0
